# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://albo:albo@localhost:5432/albo

# --- Backend --------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Autenticazione: "oidc" in produzione, "dev" solo in locale (login per username, nessun IdP)
AUTH_MODE=dev
DEV_AUTH_SECRET=cambia-questo-segreto-locale-di-almeno-32-caratteri

# OIDC (es. Microsoft Entra ID)
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=api://albo-fornitori
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_STRIP_UPN_DOMAIN=true

# --- Frontend (letti da Vite, prefisso VITE_) -----------------------------
VITE_AUTH_MODE=dev
# VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# VITE_OIDC_CLIENT_ID=<client-id-spa>
# VITE_OIDC_SCOPE=openid profile api://albo-fornitori/access
