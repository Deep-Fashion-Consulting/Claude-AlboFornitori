# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://albo:albo@localhost:5432/albo

# --- Backend --------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Sessioni: scadenza dopo N minuti di inattività, e comunque dopo N ore
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Il cookie di sessione viaggia solo su HTTPS: attivo di default in produzione.
# Metti false solo per prove interne su HTTP (le password viaggerebbero in chiaro).
# COOKIE_SECURE=false
